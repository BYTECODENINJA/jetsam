{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "productName": "jetsam",
  "version": "0.1.0",
  "identifier": "dev.jetsam.app",
  "app": {
    "windows": [
      {
        "title": "Jetsam",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
